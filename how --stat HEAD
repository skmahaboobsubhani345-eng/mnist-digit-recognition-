[32m+[m[32mdef main():[m
[32m+[m[32m    (x_train, y_train), (x_test, y_test) = load_data()[m
[32m+[m
[32m+[m[32m    # Save a peek at raw sample digits[m
[32m+[m[32m    plot_sample_digits([m
[32m+[m[32m        np.expand_dims(x_train, -1), y_train,[m
[32m+[m[32m        os.path.join(OUTPUT_DIR, "sample_digits.png"),[m
[32m+[m[32m    )[m
[32m+[m
[32m+[m[32m    x_train_p, y_train_cat, x_test_p, y_test_cat = preprocess([m
[32m+[m[32m        x_train, y_train, x_test, y_test[m
[32m+[m[32m    )[m
[32m+[m
[32m+[m[32m    model = build_model()[m
[32m+[m[32m    model.summary()[m
[32m+[m
[32m+[m[32m    callbacks = [[m
[32m+[m[32m        keras.callbacks.EarlyStopping([m
