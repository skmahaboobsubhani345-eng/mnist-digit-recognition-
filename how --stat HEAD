[32m+[m[32m        ),[m
[32m+[m[32m        keras.callbacks.ReduceLROnPlateau([m
[32m+[m[32m            monitor="val_loss", factor=0.5, patience=2, min_lr=1e-6[m
[32m+[m[32m        ),[m
[32m+[m[32m    ][m
[32m+[m
[32m+[m[32m    print