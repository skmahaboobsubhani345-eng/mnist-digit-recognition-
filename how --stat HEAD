[32m+[m[32m"""[m
[32m+[m[32mDigit Recognition using the MNIST Dataset[m
[32m+[m[32m==========================================[m
[32m+[m
[32m+[m[32mGoal[m
[32m+[m[32m----[m
[32m+[m[32mClassify 28x28 grayscale images of handwritten digits (0-9) into the[m
[32m+[m[32mcorrect digit class using a Convolutional Neural Network (CNN).[m
[32m+[m
[32m+[m[32mPipeline[m
[32m+[m[32m--------[m
[32m+[m[32m1. Load & explore the MNIST dataset[m
[32m+[m[32m2. Preprocess (normalize, reshape, one-hot encode)[m
[32m+[m[32m3. Build a CNN model[m
[32m+[m[32m4. Train with validation split[m
[32m+[m[32m5. Evaluate on the test set (accuracy, confusion matrix, classification report)[m
[32m+[m[32m6. Visualize training curves and sample predictions[m
[32m+[m[32m7. Save the trained model for reuse/deployment[m
[32m+[m
[32m+[m[32mRun:[m
[32m+[m[32m    python mnist_digit_recognition.py[m
[32m+[m[32m"""[m
[32m+[m
[32m+[m[32mimport gzip[m
[32m+[m[32mimport os[m
[32m+[m[32mimport urllib.request[m
[32m+[m
[32m+[m[32mimport numpy as np[m
[32m+[m[32mimport matplotlib[m
[32m+[m[32mmatplotlib.use("Agg")  # headless-safe backend[m
[32m+[m[32mimport matplotlib.pyplot as plt[m
[32m+[m[32mimport seaborn as sns[m
[32m+[m
[32m+[m[32mimport tensorflow as tf[m
[32m+[m[32mfrom tensorflow import keras[m
[32m+[m[32mfrom tensorflow.keras import layers[m
[32m+[m
[32m+[m[32mfrom sklearn.metrics import confusion_matrix, classification_report[m
[32m+[m
[32m+[m[32mOUTPUT_DIR = "outputs"[m
[32m+[m[32mos.makedirs(OUTPUT_DIR, exist_ok=True)[m
[32m+[m
[32m+[m[32mRANDOM_SEED = 42[m
[32m+[m[32mtf.random.set_seed(RANDOM_SEED)[m
[32m+[m[32mnp.random.seed(RANDOM_SEED)[m
[32m+[m
[32m+[m
[32m+[m[32m# ---------------------------------------------------------------------------[m
[32m+[m[32m# 1. LOAD DATA[m
[32m+[m[32m# ---------------------------------------------------------------------------[m
[32m+[m[32mMNIST_MIRROR = "https://raw.githubusercontent.com/fgnt/mnist/master/"[m
[32m+[m[32mMNIST_FILES = {[m
[32m+[m[32m    "train_images": "train-images-idx3-ubyte.gz",[m
[32m+[m[32m    "train_labels": "train-labels-idx1-ubyte.gz",[m
[32m+[m[32m    "test_images": "t10k-images-idx3-ubyte.gz",[m
[32m+[m[32m    "test_labels": "t10k-labels-idx1-ubyte.gz",[m
[32m+[m[32m}[m
[32m+[m
[32m+[m
[32m+[m[32mdef _read_idx_images(path):[m
[32m+[m[32m    with gzip.open(path, "rb") as f:[m
[32m+[m[32m        f.read(16)  # header: magic, n_images, rows, cols[m
[32m+[m[32m        buf = f.read()[m
[32m+[m[32m    return np.frombuffer(buf, dtype=np.uint8).reshape(-1, 28, 28)[m
[32m+[m
[32m+[m
[32m+[m[32mdef _read_idx_labels(path):[m
[32m+[m[32m    with gzip.open(path, "rb") as f:[m
[32m+[m[32m        f.read(8)  # header: magic, n_labels[m
[32m+[m[32m        buf = f.read()[m
[32m+[m[32m    return np.frombuffer(buf, dtype=np.uint8)[m
[32m+[m
[32m+[m
[32m+[m[32mdef load_data(cache_dir="data_raw"):[m
[32m+[m[32m    """[m
[32m+[m[32m    Load MNIST. Tries the standard Keras loader first; falls back to a[m
[32m+[m[32m    GitHub-hosted mirror of the original ubyte files if that download[m
[32m+[m[32m    is blocked (e.g. restricted network egress to storage.googleapis.com).[m
[32m+[m[32m    """[m
[32m+[m[32m    print("Loading MNIST dataset...")[m
[32m+[m[32m    try:[m
[32m+[m[32m        (x_train, y_train), (x_test, y_test) = keras.datasets.mnist.load_data()[m
[32m+[m[32m    except Exception as e:[m
[32m+[m[32m        print(f"Default Keras download failed ({e}). Falling back to GitHub mirror...")[m
[32m+[m[32m        os.makedirs(cache_dir, exist_ok=True)[m
[32m+[m[32m        paths = {}[m
[32m+[m[32m        for key, fname in MNIST_FILES.items():[m
[32m+[m[32m            local_path = os.path.join(cache_dir, fname)[m
[32m+[m[32m            if not os.path.exists(local_path):[m
[32m+[m[32m                urllib.request.urlretrieve(MNIST_MIRROR + fname, local_path)[m
[32m+[m[32m            paths[key] = local_path[m
[32m+[m
[32m+[m[32m        x_train = _read_idx_images(paths["train_images"])[m
[32m+[m[32m        y_train = _read_idx_labels(paths["train_labels"])[m
[32m+[m[32m        x_test = _read_idx_images(paths["test_images"])[m
[32m+[m[32m        y_test = _read_idx_labels(paths["test_labels"])[m
[32m+[m
[32m+[m[32m    print(f"Train images: {x_train.shape}, Train labels: {y_train.shape}")[m
[32m+[m[32m    print(f"Test images:  {x_test.shape}, Test labels:  {y_test.shape}")[m
[32m+[m[32m    return (x_train, y_train), (x_test, y_test)[m
[32m+[m
[32m+[m
[32m+[m[32m# ---------------------------------------------------------------------------[m
[32m+[m[32m# 2. PREPROCESS[m
[32m+[m[32m# ---------------------------------------------------------------------------[m
[32m+[m[32mdef preprocess(x_train, y_train, x_test, y_test, num_classes=10):[m
[32m+[m[32m    # Normalize pixel values to [0, 1][m
[32m+[m[32m    x_train = x_train.astype("float32") / 255.0[m
[32m+[m[32m    x_test = x_test.astype("float32") / 255.0[m
[32m+[m
[32m+[m[32m    # Add channel dimension: (N, 28, 28) -> (N, 28, 28, 1)[m
[32m+[m[32m    x_train = np.expand_dims(x_train, -1)[m
[32m+[m[32m    x_test = np.expand_dims(x_test, -1)[m
[32m+[m
[32m+[m[32m    # One-hot encode labels[m
[32m+[m[32m    y_train_cat = keras.utils.to_categorical(y_train, num_classes)[m
[32m+[m[32m    y_test_cat = keras.utils.to_categorical(y_test, num_classes)[m
[32m+[m
[32m+[m[32m    return x_train, y_train_cat, x_test, y_test_cat[m
[32m+[m
[32m+[m
[32m+[m[32m# ---------------------------------------------------------------------------[m
[32m+[m[32m# 3. BUILD MODEL[m
[32m+[m[32m# ---------------------------------------------------------------------------[m
[32m+[m[32mdef build_model(input_shape=(28, 28, 1), num_classes=10):[m
[32m+[m[32m    model = keras.Sequential([m
[32m+[m[32m        [[m
[32m+[m[32m            layers.Input(shape=input_shape),[m
[32m+[m
[32m+[m[32m            layers.Conv2D(32, kernel_size=3, activation="relu", padding="same"),[m
[32m+[m[32m            layers.BatchNormalization(),[m
[32m+[m[32m            layers.Conv2D(32, kernel_size=3, activation="relu", padding="same"),[m
[32m+[m[32m            layers.MaxPooling2D(pool_size=2),[m
[32m+[m[32m            layers.Dropout(0.25),[m
[32m+[m
[32m+[m[32m            layers.Conv2D(64, kernel_size=3, activation="relu", padding="same"),[m
[32m+[m[32m            layers.BatchNormalization(),[m
[32m+[m[32m            layers.Conv2D(64, kernel_size=3, activation="relu", padding="same"),[m
[32m+[m[32m            layers.MaxPooling2D(pool_size=2),[m
[32m+[m[32m            layers.Dropout(0.25),[m
[32m+[m
[32m+[m[32m            layers.Flatten(),[m
[32m+[m[32m            layers.Dense(256, activation="relu"),[m
[32m+[m[32m            layers.BatchNormalization(),[m
[32m+[m[32m            layers.Dropout(0.5),[m
[32m+[m[32m            layers.Dense(num_classes, activation="softmax"),[m
[32m+[m[32m        ][m
[32m+[m[32m    )[m
[32m+[m
[32m+[m[32m    model.compile([m
[32m+[m[32m        optimizer="adam",[m
[32m+[m[32m        loss="categorical_crossentropy",[m
[32m+[m[32m        metrics=["accuracy"],[m
[32m+[m[32m    )[m
[32m+[m[32m    return model[m
[32m+[m
[32m+[m
[32m+[m[32m# ---------------------------------------------------------------------------[m
[32m+[m[32m# 4. VISUALIZATION HELPERS[m
[32m+[m[32m# ---------------------------------------------------------------------------[m
[32m+[m[32mdef plot_sample_digits(x, y, path):[m
